{
  "name": "devneural-daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DevNeural v2 daemon: capture, ingest, query, lint over a semantic concept wiki",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/daemon.ts",
    "start": "node dist/daemon.js",
    "hook": "node dist/capture/hooks/hook-runner.js",
    "install-hooks": "node dist/capture/hooks/install-hooks.js",
    "dedupe-hooks": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dedupe-hooks.ps1",
    "silence-hooks": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/silence-all-hooks.ps1",
    "setup": "npm run build && node dist/cli/setup.js",
    "status": "node dist/cli/status.js",
    "backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup.ps1",
    "restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restore.ps1",
    "verify-backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-backup.ps1",
    "install-backup-task": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-backup-task.ps1",
    "install-daemon-autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-daemon-autostart.ps1",
    "uninstall-daemon-autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-daemon-autostart.ps1 -Disable",
    "install-offsite-backup-task": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-offsite-backup-task.ps1",
    "uninstall-offsite-backup-task": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-offsite-backup-task.ps1 -Disable",
    "backup-where": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/show-backup-target.ps1",
    "test": "vitest run",
    "build:check": "tsc --noEmit",
    "canary": "tsx scripts/canary.ts",
    "migrate": "tsx src/db/migrate.ts",
    "backfill-brainstorms": "tsx scripts/backfill-brainstorms.ts",
    "audit-doc-ingest": "tsx scripts/audit-doc-ingest.ts",
    "lex-replay": "tsx scripts/lex-replay.ts",
    "dump-distillations": "tsx scripts/dump-distillations.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "@types/web-push": "^3.6.4",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^4.0.0",
    "fastify": "^5.0.0",
    "mammoth": "^1.12.0",
    "node-pty": "^1.1.0",
    "onnxruntime-node": "^1.27.0",
    "pdf-parse": "^2.4.5",
    "pdf-to-png-converter": "^4.0.0",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
